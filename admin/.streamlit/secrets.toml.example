# Copy this file to secrets.toml (same folder) for local use, or paste its contents into
# Streamlit Community Cloud: your app -> Settings -> Secrets.
# Never commit secrets.toml; it is in .gitignore.

# Supabase: Project Settings -> API (or "API Keys").
SUPABASE_URL = "https://YOUR-PROJECT.supabase.co"
# The public key ("anon" or "publishable"). Used only for signing in.
SUPABASE_ANON_KEY = "..."
# The secret key ("service_role" or "secret"). Reads and writes the bot tables.
SUPABASE_SERVICE_ROLE_KEY = "..."

# The chat site on Vercel, used for test links and Moodle embed code.
CHAT_SITE_URL = "https://YOUR-SITE.vercel.app"

# A shared code visitors must enter before they see the sign-in page. Give it only to staff.
# Change it here at any time; everyone then needs the new code. Leave it out to skip this step.
ACCESS_CODE = "choose-a-long-code"
