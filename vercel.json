{
  "outputDirectory": "public",
  "functions": {
    "api/chat.js": {
      "includeFiles": "bots/**",
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
